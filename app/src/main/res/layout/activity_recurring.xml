<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_navy">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_primary"
            app:title="পুনরাবৃত্ত লেনদেন"
            app:titleTextColor="@color/text_primary">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_sync"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Recurring Bills"
                    android:textColor="@color/mint_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সাবস্ক্রিপশন, ইউটিলিটি বিল ও নিয়মিত লেনদেন"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <!-- Commitment Overview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_navy_elevated"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="মাসিক পুনরাবৃত্ত ব্যয় • Monthly Total"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvActiveRecurringCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_sync"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="০টি সচল"
                            android:textColor="@color/mint_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMonthlyRecurringTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        tools:text="৳ ২১,৪০০ / মাস" />

                    <!-- Upcoming 7 Days Amber Alert Pill -->
                    <LinearLayout
                        android:id="@+id/llUpcomingAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_net_cashflow_banner"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_debt">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_notification"
                                app:tint="@color/amber_primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="আসন্ন ৭ দিনে বকেয়া বিল"
                                android:textColor="@color/amber_primary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvUpcomingAlertText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="পরিশোধের তারিখ কাছাকাছি"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvUpcomingAlertAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/amber_primary"
                            android:textSize="14sp"
                            tools:text="৳ ৭,২০০" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Add Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddNewRecurring"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_teal"
                android:text="+ নতুন বিল বা সাবস্ক্রিপশন যোগ করুন"
                android:textColor="@color/text_inverse"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/text_inverse" />

            <!-- Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRecurring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRecurringAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="সব (All)"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/surface_navy_elevated" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRecurringMonthly"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="মাসিক (Monthly)"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/surface_navy_elevated" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRecurringWeekly"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সাপ্তাহিক (Weekly)"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/surface_navy_elevated" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRecurringYearly"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="বাৎসরিক (Yearly)"
                        android:textColor="@color/text_primary"
                        app:chipBackgroundColor="@color/surface_navy_elevated" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Recurring List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecurring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_recurring_card" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/llEmptyRecurring"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_recurring">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_recurring"
                        app:tint="@color/teal_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="কোন নিয়মিত বিল বা সাবস্ক্রিপশন নেই"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="বাসা ভাড়া, ওয়াইফাই বিল ও সাবস্ক্রিপশন যুক্ত করে স্বয়ংক্রিয় হিসাব রাখুন"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
