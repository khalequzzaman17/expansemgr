<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_dark"
    android:orientation="vertical">

    <!-- Top Bar with Bengal Ledger Heading -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_lowest"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="লেনদেনের খাতা • Transactions"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="আয়, ব্যয় ও স্থানান্তরের বিস্তারিত তালিকা"
            android:textColor="@color/teal_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Bar with Search & Sort -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_sync"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/teal_light"
            android:hint="লেনদেন অনুসন্ধান করুন..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivSort"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_sync"
            android:padding="11dp"
            android:src="@drawable/ic_sort"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/ChipCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="সব • All"
                android:textColor="@color/chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipExpense"
                style="@style/ChipCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ব্যয় • Expense"
                android:textColor="@color/chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIncome"
                style="@style/ChipCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আয় • Income"
                android:textColor="@color/chip_text" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTransfer"
                style="@style/ChipCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="স্থানান্তর • Transfer"
                android:textColor="@color/chip_text" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Count Summary -->
    <TextView
        android:id="@+id/tvTransactionCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="4dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="Showing 24 transactions" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/no_transactions_found"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
